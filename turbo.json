{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "codegen": {
      // bridge-types is an input even though no task here reads it directly: a nitro spec imports
      // its types from there, so the generated C++ follows that package's shape. Left out, the
      // cache key does not move when it changes -- and turbo then *restores* the stale generated
      // files over the correct ones, which reverts a committed regeneration with nothing said.
      "inputs": [
        "proto/**",
        "src/**/*.nitro.ts",
        "buf.gen.yaml",
        "../../packages/bridge-types/src/**"
      ],
      "outputs": ["src/gen/**", "nitrogen/generated/**"]
    },
    "codegen:check": {
      "dependsOn": ["codegen"],
      "cache": false
    },
    "@session/app#codegen": {
      // Never cached: CI has no submodule checkout, so the key could not move on a bump and a cache
      // hit would restore the previous table over the committed one. The inputs only say what the
      // generator reads.
      "inputs": [
        "scripts/**",
        "../../libsession-util/include/session/session_protocol.h",
        "../../libsession-util/src/session_protocol.cpp"
      ],
      "outputs": ["src/urls.generated.ts"],
      "cache": false
    },
    "@session/bridge-codegen#codegen": {
      "inputs": ["src/**", "../../packages/bridge-types/src/**"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**", "out/**"]
    },
    "build:native": {
      "inputs": ["src/**", "CMakeLists.txt", "../bridge-core/**", "../../libsession-util/**"],
      "outputs": ["prebuilds/**", "build/Release/**"]
    },
    "dev": {
      "dependsOn": ["^codegen"],
      "cache": false,
      "persistent": true
    },
    "dev:fake": {
      "dependsOn": ["^codegen"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^codegen", "^build"]
    },
    "lint": {
      // @session/localization is consumed as built output, so its declarations have to exist
      // before anything importing it can be type-aware-linted. Without this the typed rules do
      // not fail, they go blind: tr() resolves to the error type and every rule that touches it
      // reports "could not be resolved" instead of checking anything.
      "dependsOn": ["^build", "^codegen"]
    },
    "test": {
      "dependsOn": ["^codegen"],
      "outputs": ["coverage/**"]
    },
    "test:e2e:fast": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e:full": {
      "dependsOn": ["^build", "^build:native"],
      "cache": false
    }
  }
}
