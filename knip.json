{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/localization": {
      "project": ["src/**/*.ts", "!src/localization-src/**"]
    }
  },
  "ignoreDependencies": [
    "expo-updates",
    "expo-system-ui",
    "@bufbuild/protoc-gen-es",
    "dependency-cruiser",
    "@s2/eslint-config",
    "@s2/typescript-config",
    "eslint-import-resolver-typescript",
    "react-native-web"
  ],
  "ignore": ["**/*.native.tsx"]
}
