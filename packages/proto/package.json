{
  "name": "@s2/proto",
  "version": "0.0.0",
  "private": true,
  "description": "The bridge wire format: commands, responses and events, plus their generated codecs",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "codegen": "buf generate",
    "codegen:check": "buf generate && git diff --exit-code -- src/gen",
    "lint": "eslint . && buf lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:"
  },
  "devDependencies": {
    "@bufbuild/buf": "catalog:",
    "@bufbuild/protoc-gen-es": "catalog:",
    "@s2/eslint-config": "workspace:*",
    "@s2/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
