{
  "name": "@session/localization",
  "version": "0.0.0",
  "private": true,
  "description": "Localized strings and the segment parsers, wrapping the session-localization submodule",
  "type": "module",
  "main": "./dist/index.js",
  "imports": {
    "#src/*": [
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --tsconfig tsconfig.build.json --clean",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@session/basic-types": "workspace:*"
  },
  "devDependencies": {
    "@session/eslint-config": "workspace:*",
    "@session/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
