{
  "name": "@s2/localization",
  "version": "0.0.0",
  "private": true,
  "description": "Localized strings and the segment parsers, wrapping the session-localization submodule",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --tsconfig tsconfig.build.json --clean",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@s2/basic-types": "workspace:*"
  },
  "devDependencies": {
    "@s2/eslint-config": "workspace:*",
    "@s2/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
