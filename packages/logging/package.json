{
  "name": "@session/logging",
  "version": "0.0.0",
  "private": true,
  "description": "Device logs: the line format, redaction by type, rotation, and the export",
  "type": "module",
  "main": "./src/index.ts",
  "imports": {
    "#src/*": [
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@session/eslint-config": "workspace:*",
    "@session/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
