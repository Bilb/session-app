{
  "extends": "@session/typescript-config/bundler.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    // The token-contract test reads every source file that uses a `$token` off disk, which is
    // the only reason node types are here - the same reason packages/app has them.
    "types": ["react", "node"]
  },
  // The .native variants are typechecked by apps/mobile, which loads react-native's types
  // and sets moduleSuffixes. Checking them here, against a DOM lib, would only produce
  // clashes between two sets of globals that are never both present at runtime.
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/**/*.native.ts", "src/**/*.native.tsx"]
}
