{
  "extends": "@s2/typescript-config/bundler.json",
  "compilerOptions": {
    "types": ["react"],
    // DOM is here for the same reason Expo's own base config includes it: libraries in the
    // tree ship web helpers as TypeScript source and this program compiles them. The real
    // platform-neutrality guarantee is not here anyway — each shared package has its own
    // pass with `types: []` and no DOM, where a stray `window` is an error.
    "lib": ["ES2022", "DOM"],
    // The react-native half of the environment split. This pass re-checks every shared
    // package the app pulls in — screens, ui, state, client — against react-native's types
    // instead of the DOM, and moduleSuffixes is what makes it resolve the .native variants.
    // The desktop renderer checks the same sources again under a browser lib.
    "moduleSuffixes": [".native", ".android", ""],
    "jsx": "react-jsx"
  },
  "include": ["index.ts", "app", "src", "*.js"],
  "exclude": ["node_modules", ".expo", "android", "ios"]
}
