{
  "name": "@session/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "The Session mobile app: one Expo app for Android and iOS, phone and tablet",
  "main": "index.ts",
  "scripts": {
    "dev": "SESSION_FAKE=1 expo start --dev-client",
    "dev:real": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@session/app": "workspace:*",
    "@session/bridge-rn": "workspace:*",
    "@session/client": "workspace:*",
    "@session/screens": "workspace:*",
    "@session/state": "workspace:*",
    "@session/ui": "workspace:*",
    "expo": "catalog:",
    "expo-constants": "catalog:",
    "expo-crypto": "catalog:",
    "expo-file-system": "catalog:",
    "expo-linking": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-nitro-modules": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-web": "catalog:"
  },
  "devDependencies": {
    "@session/eslint-config": "workspace:*",
    "@session/typescript-config": "workspace:*",
    "@tamagui/babel-plugin": "catalog:",
    "@types/react": "catalog:",
    "babel-plugin-react-remove-properties": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
