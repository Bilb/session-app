{
  "expo": {
    "name": "Session",
    "slug": "session-app",
    "scheme": "session",
    "version": "0.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.getsession.session2",
      "entitlements": {
        "keychain-access-groups": ["$(AppIdentifierPrefix)org.getsession.session2"]
      }
    },
    "android": {
      "package": "org.getsession.session2",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#333132"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": false,
          "granularPermissions": ["photo", "video"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
