{
  "name": "@session/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "The Session desktop app: Electron, drawing the shared screens",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "SESSION_FAKE=1 env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "dev:real": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "start": "SESSION_FAKE=1 env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@session/app": "workspace:*",
    "@session/basic-types": "workspace:*",
    "@session/bridge-node": "workspace:*",
    "@session/client": "workspace:*",
    "@session/screens": "workspace:*",
    "@session/state": "workspace:*",
    "@session/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-web": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@session/eslint-config": "workspace:*",
    "@session/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "catalog:",
    "electron-vite": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
