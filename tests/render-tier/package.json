{
  "name": "@session/render-tier",
  "version": "0.0.0",
  "private": true,
  "description": "The render tier: how a test renders the web flavour under happy-dom, and reads an element back as the node an expectation describes",
  "type": "module",
  "main": "./src/index.ts",
  "imports": {
    "#src/*": [
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./vitest": "./src/vitest.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@session/expectations": "workspace:*",
    "@session/test-ids": "workspace:*",
    "dom-accessibility-api": "catalog:"
  },
  "devDependencies": {
    "@session/eslint-config": "workspace:*",
    "@session/typescript-config": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@testing-library/react": "catalog:",
    "vitest": "catalog:"
  }
}
