{
  "name": "@session/turbo-guard",
  "version": "0.0.0",
  "private": true,
  "description": "Checks that turbo's cache keys cover what each cached output depends on, as CI's checkout sees it",
  "type": "module",
  "imports": {
    "#src/*": [
      "./src/*.ts"
    ]
  },
  "scripts": {
    "check": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@session/eslint-config": "workspace:*",
    "@session/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "vitest": "catalog:"
  }
}
