{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Base",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      // @s2/localization is the one package consumed as built output rather than source.
      // It wraps the session-localization submodule, whose generated files do not satisfy
      // this config's strict flags — and are not ours to change. Building it means every
      // consumer reads declarations, which skipLibCheck covers, instead of pulling vendored
      // sources into its own program. Everything else resolves to src.
      "@s2/localization": ["${configDir}/../../packages/localization/dist/index.d.ts"],
      "@s2/*": ["${configDir}/../../packages/*/src"]
    }
  }
}
