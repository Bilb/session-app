diff --git a/deps/StaticBuild.cmake b/deps/StaticBuild.cmake
index 86e05e6..7aafcb7 100644
--- a/deps/StaticBuild.cmake
+++ b/deps/StaticBuild.cmake
@@ -265,6 +265,18 @@ if(deps_cxx_stdlib)
     list(APPEND deps_cmake_toolchain_args "-DCMAKE_CXX_FLAGS=${deps_cxx_stdlib}")
 endif()
 
+# CMake-based dependencies need the cross toolchain too, not just the compiler binary: the NDK's
+# clang without the NDK's target builds for the host, and the result is an archive full of
+# libstdc++ symbols that do not exist on Android.  Autotools deps do not need this because
+# deps_cc above is already the target-prefixed driver.
+if(CMAKE_SYSTEM_NAME STREQUAL "Android")
+    list(APPEND deps_cmake_toolchain_args
+        "-DCMAKE_TOOLCHAIN_FILE=${CMAKE_TOOLCHAIN_FILE}"
+        "-DANDROID_ABI=${ANDROID_ABI}"
+        "-DANDROID_PLATFORM=${ANDROID_PLATFORM}"
+        "-DANDROID_STL=${ANDROID_STL}")
+endif()
+
 
 
 if("${CMAKE_GENERATOR}" STREQUAL "Unix Makefiles")
