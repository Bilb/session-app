 import { NitroConfig } from '../../config/NitroConfig.js';
+/**
+ * Macros the platform toolchains define before a single line of ours is parsed: the NDK passes
+ * `-DANDROID=1`, an Xcode Debug configuration passes `-DDEBUG=1`, and a Release one `-DNDEBUG=1`.
+ *
+ * A C++ enumerator is the JS value uppercased, so a union carrying `'android'` or `'debug'` -
+ * both ordinary things to name - produces an enumerator the preprocessor rewrites to `1` before
+ * the compiler sees an identifier at all. The error surfaces as `expected identifier` pointing at
+ * generated code that looks perfectly correct.
+ *
+ * Add to this only for a macro that is genuinely predefined on a platform Nitrogen builds for.
+ */
+const RESERVED_BY_TOOLCHAIN = new Set(['ANDROID', 'DEBUG', 'NDEBUG']);
+/**
+ * The C++ enumerator for a JS value. The trailing underscore keeps a colliding name legal while
+ * leaving the JS string and the Swift name alone, so nothing about the API changes.
+ */
+function enumMemberName(value) {
+    const name = escapeCppName(value).toUpperCase();
+    return RESERVED_BY_TOOLCHAIN.has(name) ? `${name}_` : name;
+}
 export class EnumType {
     enumName;
     enumMembers;
