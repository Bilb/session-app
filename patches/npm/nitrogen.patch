 import { escapeCppName } from '../helpers.js';
 import { createCppUnion } from '../c++/CppUnion.js';
 import { NitroConfig } from '../../config/NitroConfig.js';
+/**
+ * The prefix every member of a C++ enum carries.
+ *
+ * Two problems that are really one. A C++ enumerator is not scoped as far as the preprocessor is
+ * concerned, so a bare `ANDROID` or `DEBUG` is rewritten to `1` - by the NDK's `-DANDROID=1`, and
+ * by an Xcode Debug configuration's `-DDEBUG=1` - before the compiler ever sees an identifier. The
+ * error is `expected identifier`, pointing at generated code that reads perfectly correctly, and it
+ * says nothing about why. `ERROR` is the same trap waiting on Windows.
+ *
+ * Renaming only the members that collide fixes today and leaves one odd member per enum, which is
+ * its own problem: nothing tells a reader whether `DEBUG_` is deliberate or a typo, and the next
+ * collision is still there to be found the hard way. So every member is prefixed, colliding or
+ * not, and no member of a Nitrogen enum can be eaten by a bare macro again.
+ *
+ * The names below read better than the type names they stand for, and are the enums in
+ * @session/bridge-types. Anything not listed falls back to its own name, which is safe rather than
+ * short - add an entry when a new enum wants better.
+ *
+ * None of this reaches the API: the JS string and the `SWIFT_NAME(...)` are untouched, so it is a
+ * C++ spelling and nothing else.
+ */
+const CPP_ENUM_PREFIXES = {
+    NetId: 'NET',
+    DeviceType: 'DEVICE',
+    LibsessionLogLevel: 'LEVEL'
+};
+function screamingSnake(name) {
+    return name.replace(/([a-z0-9])([A-Z])/g, '$1_$2').toUpperCase();
+}
+function enumMemberName(enumName, value) {
+    const prefix = CPP_ENUM_PREFIXES[enumName] ?? screamingSnake(enumName);
+    return `${prefix}_${escapeCppName(value).toUpperCase()}`;
+}
 export class EnumType {
     enumName;
     enumMembers;
@@ -24,7 +57,7 @@ export class EnumType {
                         `Each enum member must be a number! If you want to use strings, use TypeScript unions ("a" | "b") instead!`);
                 }
                 return {
-                    name: escapeCppName(name).toUpperCase(),
+                    name: enumMemberName(enumName, name),
                     value: value,
                     stringValue: name,
                 };
@@ -43,7 +76,7 @@ export class EnumType {
                     if (typeof literalValue !== 'string')
                         throw new Error(`${enumName}: Value "${literalValue}" is not a string - it is ${typeof literalValue}!`);
